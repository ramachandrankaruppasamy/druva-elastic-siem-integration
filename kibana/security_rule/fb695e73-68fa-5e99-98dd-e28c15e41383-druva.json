{
  "id": "fb695e73-68fa-5e99-98dd-e28c15e41383-druva",
  "type": "security-rule",
  "attributes": {
    "rule_id": "fb695e73-68fa-5e99-98dd-e28c15e41383",
    "name": "Druva - Administrator Changes Multiple Resources",
    "description": "Detects a single administrator acting on an unusually large number of protected resources during a short period.",
    "risk_score": 47,
    "severity": "medium",
    "enabled": false,
    "interval": "5m",
    "from": "now-6m",
    "to": "now",
    "author": [
      "Druva"
    ],
    "license": "Elastic License v2",
    "references": [],
    "false_positives": [],
    "threat": [],
    "exceptions_list": [],
    "actions": [],
    "tags": [
      "Druva",
      "Druva Security",
      "Druva Phase 1",
      "Druva Detection Pack 1 – Administrator & Identity",
      "Druva Category: Identity",
      "Druva Category: Administrator",
      "Druva Category: Behavioral Analytics",
      "Druva Category: Protected Resources",
      "Druva Category: Impact",
      "Druva: Review Threshold"
    ],
    "version": 1,
    "index": [
      "logs-druva.event-*"
    ],
    "meta": {
      "from": "Druva Detection Policies Phase 1",
      "pack": "Druva Detection Pack 1 – Administrator & Identity",
      "phase": "Phase 1",
      "primary_data_source": "logs-druva.event-*",
      "external_dependency": "Threat intelligence / VPN-TOR enrichment",
      "team_to_target": "SOC; IAM/Identity",
      "customer_usecase": "Detects a single administrator acting on an unusually large number of protected resources during a short period."
    },
    "type": "threshold",
    "language": "kuery",
    "query": "druva.feature:\"Admin Event\"\nand druva.resource.name:*",
    "threshold": {
      "field": [
        "json.details.initiator"
      ],
      "value": 1,
      "cardinality": [
        {
          "field": "json.details.resourceName",
          "value": 5
        }
      ]
    }
  }
}
