{
  "id": "1425e5a3-b9a5-5e24-9839-c7690c1f63a2-druva",
  "type": "security-rule",
  "attributes": {
    "rule_id": "1425e5a3-b9a5-5e24-9839-c7690c1f63a2",
    "name": "Druva - Backup Repository Deleted",
    "description": "Detects deletion or removal of a backup repository or storage target.",
    "risk_score": 73,
    "severity": "high",
    "enabled": false,
    "interval": "5m",
    "from": "now-6m",
    "to": "now",
    "author": [
      "Druva"
    ],
    "license": "Elastic License v2",
    "references": [],
    "false_positives": [],
    "threat": [],
    "exceptions_list": [],
    "actions": [],
    "tags": [
      "Druva",
      "Druva Security",
      "Druva Phase 1",
      "Druva Detection Pack 2 – Backup Operations",
      "Druva Category: Backup",
      "Druva Category: Repository",
      "Druva Category: Deletion",
      "Druva Category: Impact"
    ],
    "version": 1,
    "index": [
      "logs-druva.event-*"
    ],
    "meta": {
      "from": "Druva Detection Policies Phase 1",
      "pack": "Druva Detection Pack 2 – Backup Operations",
      "phase": "Phase 1",
      "primary_data_source": "logs-druva.event-*",
      "external_dependency": "Threat intelligence / VPN-TOR enrichment",
      "team_to_target": "SOC; Backup/Recovery",
      "customer_usecase": "Detects deletion or removal of a backup repository or storage target."
    },
    "type": "query",
    "language": "kuery",
    "query": "druva.feature:\"Admin Event\"\nand (\n  message:*repository*\n  or message:*storage target*\n)\nand (\n  message:*deleted*\n  or message:*removed*\n)"
  }
}
