            {
                "ecs": true,
                "name": "user.name",
                "type": "keyword"
            }
        ],
        "investigation_fields": {
            "field_names": [
                "@timestamp",
                "event.id",
                "event.action",
                "event.outcome",
                "event.severity",
                "druva.feature",
