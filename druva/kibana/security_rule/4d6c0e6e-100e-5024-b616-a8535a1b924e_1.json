{
    "attributes": {
        "rule_id": "4d6c0e6e-100e-5024-b616-a8535a1b924e",
        "name": "Druva - Malicious File Scan Configuration Activity",
        "description": "Detects malicious file scan configuration activity in Druva Data Security Cloud events.",
        "risk_score": 47,
        "severity": "medium",
        "interval": "5m",
        "from": "now-6m",
        "to": "now",
        "author": [
            "Druva"
        ],
        "license": "Elastic License v2",
        "references": [],
        "false_positives": [],
        "threat": [],
        "tags": [
            "Druva",
            "Data Source: Druva",
            "Druva Security",
            "Druva Detection Pack 6 \u2013 Security Configuration & Integrations",
            "Druva Phase 1",
            "Druva Category: Security Monitoring"
        ],
        "version": 1,
        "type": "query",
        "language": "kuery",
        "query": "druva.feature:\"Admin Event\"\nand druva.event_type:\"Scan Settings Updated\"\nand druva.security.control:\"malware_scan\"\nand druva.security.impact:\"reduced\"",
        "filters": [],
        "risk_score_mapping": [],
        "severity_mapping": [],
        "setup": "",
        "note": "",
        "max_signals": 100,
        "related_integrations": [
            {
                "package": "druva",
                "version": "^0.3.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "@timestamp",
                "type": "date"
            },
            {
                "ecs": false,
                "name": "druva.event_type",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.feature",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.resource.name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.action",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.id",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.outcome",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.severity",
                "type": "long"
            },
            {
                "ecs": true,
                "name": "message",
