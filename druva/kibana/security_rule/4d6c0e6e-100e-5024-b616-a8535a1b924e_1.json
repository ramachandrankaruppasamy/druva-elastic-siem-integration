{
    "attributes": {
        "rule_id": "4d6c0e6e-100e-5024-b616-a8535a1b924e",
        "name": "Druva - Malicious File Scan Configuration Activity",
        "description": "Detects malicious file scan configuration activity in Druva Data Security Cloud events.",
        "risk_score": 47,
        "severity": "medium",
        "interval": "5m",
        "from": "now-6m",
        "to": "now",
        "author": [
            "Druva"
        ],
        "license": "Elastic License v2",
        "references": [],
        "false_positives": [
            "Approved malware-scanning policy tuning.",
            "Temporary reduction of scanning during troubleshooting or performance investigation.",
            "Policy migration where scanning settings are intentionally changed and compensating controls exist."
        ],
        "threat": [
            {
                "framework": "MITRE ATT&CK",
                "tactic": {
                    "id": "TA0112",
                    "name": "Defense Impairment",
                    "reference": "https://attack.mitre.org/tactics/TA0112/"
                },
                "technique": [
                    {
                        "id": "T1685",
                        "name": "Disable or Modify Tools",
                        "reference": "https://attack.mitre.org/techniques/T1685/"
                    }
                ]
            }
        ],
        "tags": [
            "Druva",
            "Data Source: Druva",
            "Druva Security",
            "Druva Detection Pack 6 \u2013 Security Configuration & Integrations",
            "Druva Phase 1",
            "Druva Category: Security Monitoring"
        ],
        "version": 2,
        "type": "query",
        "language": "kuery",
        "query": "druva.feature:\"Admin Event\"\nand druva.event_type:\"Scan Settings Updated\"\nand druva.security.control:\"malware_scan\"\nand druva.security.impact:\"reduced\"",
        "filters": [],
        "risk_score_mapping": [],
        "severity_mapping": [],
        "setup": "",
        "note": "### Investigation guide\n\nThis rule detects a Druva malicious-file scanning configuration change that the integration has normalized as reducing malware-scan protection.\n\n#### Investigation steps\n\n- Review the previous and current scan settings to identify exactly which capability was weakened.\n- Identify the administrator and source IP responsible for the change.\n- Confirm whether the modification belongs to an approved security-policy or troubleshooting change.\n- Review nearby administrator-role, security-control, API credential, and protection changes.\n- Search for UDA, ransomware, malicious-file, or recovery activity around the same period.\n- Determine whether the scan configuration was subsequently restored.\n\n#### Response\n\n- Restore required scanning protections when the reduction was unauthorized.\n- Review privileged activity performed while scanning protections were weakened.\n- Investigate the responsible account if the change cannot be validated.",
        "max_signals": 100,
        "related_integrations": [
            {
                "package": "druva",
                "version": "^0.0.1"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "@timestamp",
                "type": "date"
            },
            {
                "ecs": false,
                "name": "druva.event_type",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.feature",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.resource.name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.action",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.id",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.outcome",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.severity",
                "type": "long"
            },
            {
                "ecs": true,
                "name": "message",
                "type": "match_only_text"
            },
            {
                "ecs": true,
                "name": "source.ip",
                "type": "ip"
            },
            {
                "ecs": true,
                "name": "user.email",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "user.name",
                "type": "keyword"
            }
        ],
        "investigation_fields": {
            "field_names": [
                "@timestamp",
                "event.id",
                "event.action",
                "event.outcome",
                "event.severity",
                "druva.feature",
                "druva.event_type",
                "user.name",
                "user.email",
                "source.ip",
                "druva.resource.name",
                "message"
            ]
        },
        "index": [
            "logs-druva.event-*"
        ]
    },
    "id": "4d6c0e6e-100e-5024-b616-a8535a1b924e_1",
    "type": "security-rule"
}
