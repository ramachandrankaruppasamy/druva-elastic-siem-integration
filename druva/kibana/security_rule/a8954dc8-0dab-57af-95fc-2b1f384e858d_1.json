{
    "attributes": {
        "rule_id": "a8954dc8-0dab-57af-95fc-2b1f384e858d",
        "name": "Druva - Backup Protection Disabled or Paused",
        "description": "Detects changes that disable, pause, or suspend backup protection for a workload or resource.",
        "risk_score": 73,
        "severity": "high",
        "interval": "5m",
        "from": "now-6m",
        "to": "now",
        "author": [
            "Druva"
        ],
        "license": "Elastic License v2",
        "references": [],
        "false_positives": [],
        "threat": [],
        "tags": [
            "Druva",
            "Data Source: Druva",
            "Druva Security",
            "Druva Detection Pack 0 \u2013 Core Cyber Resilience",
            "Druva Phase 1",
            "Druva Category: Cyber Resilience",
            "Druva Category: SOC",
            "Druva Category: Backup",
            "Druva Category: Recovery"
        ],
        "version": 1,
        "type": "query",
        "language": "kuery",
        "query": "druva.feature:\"Admin Event\"\nand (\n  druva.event_type:\"Backup Protection Disabled\"\n  or druva.event_type:\"Backup Protection Paused\"\n  or druva.event_type:\"Backup Protection Suspended\"\n)",
        "filters": [],
        "risk_score_mapping": [],
        "severity_mapping": [],
        "setup": "",
        "note": "",
        "max_signals": 100,
        "related_integrations": [
            {
                "package": "druva",
                "version": "^0.3.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "@timestamp",
                "type": "date"
            },
            {
                "ecs": false,
                "name": "druva.event_type",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.profile.name",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.resource.name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.action",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "message",
                "type": "match_only_text"
            },
            {
                "ecs": true,
                "name": "user.id",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "user.name",
                "type": "keyword"
            }
        ],
        "investigation_fields": {
            "field_names": [
                "@timestamp",
                "event.action",
                "druva.event_type",
                "user.name",
                "druva.resource.name",
                "druva.profile.name",
                "message",
                "user.id"
            ]
        },
        "index": [
            "logs-druva.event-*"
        ]
    },
    "id": "a8954dc8-0dab-57af-95fc-2b1f384e858d_1",
    "type": "security-rule"
}
