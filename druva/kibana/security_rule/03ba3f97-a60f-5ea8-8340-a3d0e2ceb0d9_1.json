        "rule_id": "03ba3f97-a60f-5ea8-8340-a3d0e2ceb0d9",
        "name": "Druva - Recovery Verification Failed",
        "description": "Detects a failed recovery verification, validation, or recovery-test event.",
        "risk_score": 73,
        "severity": "high",
        "interval": "5m",
        "from": "now-6m",
        "to": "now",
        "author": [
            "Druva"
        ],
        "license": "Elastic License v2",
        "references": [],
        "false_positives": [],
        "threat": [],
        "tags": [
            "Druva",
            "Data Source: Druva",
            "Druva Security",
            "Druva Detection Pack 3 \u2013 Cyber Recovery & Recovery Operations",
            "Druva Phase 1",
            "Druva Category: Recovery",
            "Druva Category: Verification",
            "Druva Category: Failure",
            "Druva Category: Cyber Recovery"
