{
    "attributes": {
        "rule_id": "4ac3a3ce-0bbc-550e-a02e-30301e76b8d9",
        "name": "Druva - API Token Deleted",
        "description": "Detects api token deleted in Druva Data Security Cloud events.",
        "risk_score": 73,
        "severity": "high",
        "interval": "5m",
        "from": "now-6m",
        "to": "now",
        "author": [
            "Druva"
        ],
        "license": "Elastic License v2",
        "references": [],
        "false_positives": [
            "Routine API credential rotation.",
            "Removal of credentials belonging to a retired integration or service.",
            "Revocation of a credential as part of normal access cleanup or incident response."
        ],
        "threat": [],
        "tags": [
            "Druva",
            "Data Source: Druva",
            "Druva Security",
            "Druva Detection Pack 6 – Security Configuration & Integrations",
            "Druva Phase 1",
            "Druva Category: Security Monitoring"
        ],
        "version": 2,
        "type": "query",
        "language": "kuery",
        "query": "druva.feature:\"API\"\nand druva.event_type:\"API Credentials Deleted\"",
        "filters": [],
        "risk_score_mapping": [],
        "severity_mapping": [],
        "setup": "",
        "note": "### Investigation guide\n\nThis rule detects deletion of Druva API credentials. Credential deletion may be legitimate lifecycle management, but unauthorized deletion can disrupt integrations, automation, or security monitoring.\n\n#### Investigation steps\n\n- Identify the deleted credential and administrator responsible for the action.\n- Determine which application, integration, or automation depended on the credential.\n- Confirm whether deletion was part of an approved rotation or decommissioning process.\n- Review API credential modifications and administrator activity around the event.\n- Determine whether downstream integrations or security-event delivery were disrupted.\n\n#### Response\n\n- Restore required integration access using a newly issued credential when appropriate.\n- Rotate related secrets if compromise is suspected.\n- Investigate unauthorized credential deletion and associated administrator activity.",
        "max_signals": 100,
        "related_integrations": [
            {
                "package": "druva",
                "version": "^0.3.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "@timestamp",
                "type": "date"
            },
            {
                "ecs": false,
                "name": "druva.event_type",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.feature",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.resource.name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.action",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.id",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.outcome",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.severity",
                "type": "long"
            },
            {
                "ecs": true,
                "name": "message",
                "type": "match_only_text"
            },
            {
                "ecs": true,
                "name": "source.ip",
                "type": "ip"
            },
            {
                "ecs": true,
                "name": "user.email",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "user.name",
                "type": "keyword"
            }
        ],
        "investigation_fields": {
            "field_names": [
                "@timestamp",
                "event.id",
                "event.action",
                "event.outcome",
                "event.severity",
                "druva.feature",
                "druva.event_type",
                "user.name",
                "user.email",
                "source.ip",
                "druva.resource.name",
                "message"
            ]
        },
        "index": [
            "logs-druva.event-*"
        ]
    },
    "id": "4ac3a3ce-0bbc-550e-a02e-30301e76b8d9_1",
    "type": "security-rule"
}
