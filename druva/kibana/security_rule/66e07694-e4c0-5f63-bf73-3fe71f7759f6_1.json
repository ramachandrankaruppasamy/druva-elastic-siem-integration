{
    "attributes": {
        "rule_id": "66e07694-e4c0-5f63-bf73-3fe71f7759f6",
        "name": "Druva - Resource Removed From Quarantine",
        "description": "Detects resource removed from quarantine in Druva Data Security Cloud events.",
        "risk_score": 47,
        "severity": "medium",
        "interval": "5m",
        "from": "now-6m",
        "to": "now",
        "author": [
            "Druva"
        ],
        "license": "Elastic License v2",
        "references": [],
        "false_positives": [
            "Authorized release of a resource after security investigation.",
            "Recovery personnel removing quarantine after confirming the resource is safe.",
            "Security testing or incident-response exercises."
        ],
        "threat": [
            {
                "framework": "MITRE ATT&CK",
                "tactic": {
                    "id": "TA0112",
                    "name": "Defense Impairment",
                    "reference": "https://attack.mitre.org/tactics/TA0112/"
                },
                "technique": [
                    {
                        "id": "T1685",
                        "name": "Disable or Modify Tools",
                        "reference": "https://attack.mitre.org/techniques/T1685/"
                    }
                ]
            }
        ],
        "tags": [
            "Druva",
            "Data Source: Druva",
            "Druva Security",
            "Druva Detection Pack 4 \u2013 Ransomware & Unusual Data Activity",
            "Druva Phase 1",
            "Druva Category: Security Monitoring"
        ],
        "version": 2,
        "type": "query",
        "language": "kuery",
        "query": "druva.feature:\"Ransomware Recovery\"\nand druva.operation.action:\"Delete Ranges\"",
        "filters": [],
        "risk_score_mapping": [],
        "severity_mapping": [],
        "setup": "",
        "note": "### Investigation guide\n\nThis rule detects removal of a Druva resource from quarantine. Removing quarantine may be expected after investigation, but premature or unauthorized release can reintroduce risk.\n\n#### Investigation steps\n\n- Identify the resource and administrator associated with the action.\n- Determine why the resource was originally quarantined.\n- Review the related UDA, ransomware, malicious-file, or security events.\n- Confirm that the resource was investigated and approved for release.\n- Review recovery and backup status and determine whether clean recovery points are available.\n- Check for additional activity by the administrator around the release.\n\n#### Response\n\n- Re-quarantine the resource if compromise has not been resolved.\n- Escalate unauthorized release.\n- Validate recovery and containment status before returning the resource to normal operation.",
        "max_signals": 100,
        "related_integrations": [
            {
                "package": "druva",
                "version": "^0.3.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "@timestamp",
                "type": "date"
            },
            {
                "ecs": false,
                "name": "druva.event_type",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.feature",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.resource.name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.action",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.id",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.outcome",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.severity",
                "type": "long"
            },
            {
                "ecs": true,
                "name": "message",
                "type": "match_only_text"
            },
            {
                "ecs": true,
                "name": "source.ip",
                "type": "ip"
            },
            {
                "ecs": true,
                "name": "user.email",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "user.name",
                "type": "keyword"
            }
        ],
        "investigation_fields": {
            "field_names": [
                "@timestamp",
                "event.id",
                "event.action",
                "event.outcome",
                "event.severity",
                "druva.feature",
                "druva.event_type",
                "user.name",
                "user.email",
                "source.ip",
                "druva.resource.name",
                "message"
            ]
        },
        "index": [
            "logs-druva.event-*"
        ]
    },
    "id": "66e07694-e4c0-5f63-bf73-3fe71f7759f6_1",
    "type": "security-rule"
}
