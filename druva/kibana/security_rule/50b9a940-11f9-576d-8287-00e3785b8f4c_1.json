{
    "attributes": {
        "rule_id": "50b9a940-11f9-576d-8287-00e3785b8f4c",
        "name": "Druva - Administrative Data Download",
        "description": "Detects administrative data download in Druva Data Security Cloud events.",
        "risk_score": 73,
        "severity": "high",
        "interval": "5m",
        "from": "now-6m",
        "to": "now",
        "author": [
            "Druva"
        ],
        "license": "Elastic License v2",
        "references": [],
        "false_positives": [
            "Authorized administrator export for recovery, investigation, eDiscovery, audit, or support.",
            "Approved migration or data-validation activity.",
            "Security or incident-response personnel retrieving data for analysis."
        ],
        "threat": [
            {
                "framework": "MITRE ATT&CK",
                "tactic": {
                    "id": "TA0009",
                    "name": "Collection",
                    "reference": "https://attack.mitre.org/tactics/TA0009/"
                },
                "technique": [
                    {
                        "id": "T1530",
                        "name": "Data from Cloud Storage",
                        "reference": "https://attack.mitre.org/techniques/T1530/"
                    }
                ]
            }
        ],
        "tags": [
            "Druva",
            "Data Source: Druva",
            "Druva Security",
            "Druva Detection Pack 5 – Data Access & Insider Risk",
            "Druva Phase 1",
            "Druva Category: Security Monitoring"
        ],
        "version": 2,
        "type": "query",
        "language": "kuery",
        "query": "druva.feature:\"Data Access\"\nand druva.event_type:\"Admin Download\"",
        "filters": [],
        "risk_score_mapping": [],
        "severity_mapping": [],
        "setup": "",
        "note": "### Investigation guide\n\nThis rule detects an administrative download of data from Druva. Administrative downloads may expose protected data and should be validated against the administrator's expected duties.\n\n#### Investigation steps\n\n- Identify the administrator, source IP, affected resource, and time of download.\n- Determine what data was downloaded and whether the volume or scope is expected.\n- Confirm a legitimate recovery, investigation, audit, support, or migration purpose.\n- Review recent authentication activity for the administrator, including impossible-travel or repeated-login alerts.\n- Review role changes, API credential changes, and other sensitive administrative activity.\n- Determine whether the destination or endpoint used for the download is expected.\n\n#### Response\n\n- Escalate unauthorized or unexplained downloads.\n- Review the administrator account for compromise.\n- Follow organizational procedures for potential unauthorized data access or disclosure.",
        "max_signals": 100,
        "related_integrations": [
            {
                "package": "druva",
                "version": "^0.0.1"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "@timestamp",
                "type": "date"
            },
            {
                "ecs": false,
                "name": "druva.event_type",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.feature",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.resource.name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.action",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.id",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.outcome",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.severity",
                "type": "long"
            },
            {
                "ecs": true,
                "name": "message",
                "type": "match_only_text"
            },
            {
                "ecs": true,
                "name": "source.ip",
                "type": "ip"
            },
            {
                "ecs": true,
                "name": "user.email",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "user.name",
                "type": "keyword"
            }
        ],
        "investigation_fields": {
            "field_names": [
                "@timestamp",
                "event.id",
                "event.action",
                "event.outcome",
                "event.severity",
                "druva.feature",
                "druva.event_type",
                "user.name",
                "user.email",
                "source.ip",
                "druva.resource.name",
                "message"
            ]
        },
        "index": [
            "logs-druva.event-*"
        ]
    },
    "id": "50b9a940-11f9-576d-8287-00e3785b8f4c_1",
    "type": "security-rule"
}
