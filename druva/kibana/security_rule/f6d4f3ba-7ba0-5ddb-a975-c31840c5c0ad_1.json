{
    "attributes": {
        "rule_id": "f6d4f3ba-7ba0-5ddb-a975-c31840c5c0ad",
        "name": "Druva - Unusual Data Activity Alert",
        "description": "Detects unusual data activity alert in Druva Data Security Cloud events.",
        "risk_score": 73,
        "severity": "high",
        "interval": "5m",
        "from": "now-6m",
        "to": "now",
        "author": [
            "Druva"
        ],
        "license": "Elastic License v2",
        "references": [],
        "false_positives": [
            "Legitimate high-volume file changes, migrations, synchronization, or application activity that differs from the established baseline.",
            "Security testing or ransomware simulation.",
            "Planned administrative or application activity generating unusual but authorized data changes."
        ],
        "threat": [],
        "tags": [
            "Druva",
            "Data Source: Druva",
            "Druva Security",
            "Druva Detection Pack 4 – Ransomware & Unusual Data Activity",
            "Druva Phase 1",
            "Druva Category: Security Monitoring"
        ],
        "version": 2,
        "type": "query",
        "language": "kuery",
        "query": "druva.uda.type:*\nor druva.alert.name:\"Unusual Data Activity\"",
        "filters": [],
        "risk_score_mapping": [],
        "severity_mapping": [],
        "setup": "",
        "note": "### Investigation guide\n\nThis rule detects a Druva Unusual Data Activity alert. UDA identifies behavior that differs from expected data activity and should be investigated in the context of the affected workload.\n\n#### Investigation steps\n\n- Identify the affected resource, UDA type, timestamp, and available alert details.\n- Review affected-file counts, file types, or other activity context when available.\n- Determine whether maintenance, migration, synchronization, application updates, or security testing explains the behavior.\n- Search for ransomware, quarantine, malicious-file, backup-failure, and recovery events involving the same resource.\n- Review authentication and privileged administrative activity around the alert.\n- Identify the last known-good recovery point preceding suspicious activity.\n\n#### Response\n\n- Escalate unexplained UDA when compromise is plausible.\n- Preserve clean recovery points.\n- Isolate or quarantine affected resources according to organizational incident-response procedures when necessary.",
        "max_signals": 100,
        "related_integrations": [
            {
                "package": "druva",
                "version": "^0.3.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "@timestamp",
                "type": "date"
            },
            {
                "ecs": false,
                "name": "druva.alert.name",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.event_type",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.feature",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.resource.name",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.uda.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.action",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.id",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.outcome",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.severity",
                "type": "long"
            },
            {
                "ecs": true,
                "name": "message",
                "type": "match_only_text"
            },
            {
                "ecs": true,
                "name": "source.ip",
                "type": "ip"
            },
            {
                "ecs": true,
                "name": "user.email",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "user.name",
                "type": "keyword"
            }
        ],
        "investigation_fields": {
            "field_names": [
                "@timestamp",
                "event.id",
                "event.action",
                "event.outcome",
                "event.severity",
                "druva.feature",
                "druva.event_type",
                "user.name",
                "user.email",
                "source.ip",
                "druva.resource.name",
                "druva.alert.name",
                "druva.uda.type",
                "message"
            ]
        },
        "index": [
            "logs-druva.event-*"
        ]
    },
    "id": "f6d4f3ba-7ba0-5ddb-a975-c31840c5c0ad_1",
    "type": "security-rule"
}
