        "risk_score": 73,
        "severity": "high",
        "interval": "5m",
        "from": "now-6m",
        "to": "now",
        "author": [
            "Druva"
        ],
        "license": "Elastic License v2",
        "references": [],
        "false_positives": [],
        "threat": [],
        "tags": [
            "Druva",
            "Data Source: Druva",
            "Druva Security",
            "Druva Detection Pack 2 \u2013 Backup Operations",
            "Druva Phase 1",
            "Druva Category: Backup",
            "Druva Category: Repository",
            "Druva Category: Permissions",
            "Druva Category: Access Control"
