{
    "attributes": {
        "rule_id": "332b01a5-7f94-53f8-bd0d-60197546530f",
        "name": "Druva - Recovery Started After Backup Protection Disabled",
        "description": "Detects backup protection disablement followed by restore or recovery activity for the same resource within 60 minutes.",
        "risk_score": 99,
        "severity": "critical",
        "interval": "5m",
        "from": "now-65m",
        "to": "now",
        "author": [
            "Druva"
        ],
        "license": "Elastic License v2",
        "references": [],
        "false_positives": [],
        "threat": [],
        "tags": [
            "Druva",
            "Data Source: Druva",
            "Druva Security",
            "Druva Detection Pack 3 \u2013 Cyber Recovery & Recovery Operations",
            "Druva Phase 1",
            "Druva Category: Recovery",
            "Druva Category: Backup Protection",
            "Druva Category: Correlation",
            "Druva Category: Impact"
        ],
        "version": 1,
        "index": [
            "logs-druva.event-*"
        ],
        "type": "eql",
        "language": "eql",
        "query": "sequence by druva.resource.name with maxspan=60m\n  [ any where\n      druva.event_type in (\n        \"Backup Protection Disabled\",\n        \"Backup Protection Paused\",\n        \"Backup Protection Suspended\"\n      )\n  ]\n  [ any where\n      druva.operation.type in (\"restore\", \"rollback\")\n  ]",
        "filters": [],
        "risk_score_mapping": [],
        "severity_mapping": [],
        "setup": "",
        "note": "",
        "max_signals": 100,
        "related_integrations": [
            {
                "package": "druva",
                "version": "^0.3.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "@timestamp",
                "type": "date"
            },
            {
                "ecs": false,
                "name": "druva.event_type",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.resource.name",
                "type": "keyword"
            }
        ],
        "investigation_fields": {
            "field_names": [
                "@timestamp",
                "druva.event_type",
                "druva.resource.name"
            ]
        }
    },
    "id": "332b01a5-7f94-53f8-bd0d-60197546530f_1",
    "type": "security-rule"
}
