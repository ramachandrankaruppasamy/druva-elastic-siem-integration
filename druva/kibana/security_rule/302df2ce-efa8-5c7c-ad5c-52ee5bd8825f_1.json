{
    "attributes": {
        "rule_id": "302df2ce-efa8-5c7c-ad5c-52ee5bd8825f",
        "name": "Druva - Ransomware Alert Observed",
        "description": "Detects ransomware alert observed in Druva Data Security Cloud events.",
        "risk_score": 99,
        "severity": "critical",
        "interval": "5m",
        "from": "now-6m",
        "to": "now",
        "author": [
            "Druva"
        ],
        "license": "Elastic License v2",
        "references": [],
        "false_positives": [
            "Authorized ransomware simulation, red-team exercise, or security test.",
            "Benign high-volume encryption or file transformation activity that Druva classifies as unusual.",
            "Legitimate application behavior producing an encryption-pattern UDA."
        ],
        "threat": [
            {
                "framework": "MITRE ATT&CK",
                "tactic": {
                    "id": "TA0040",
                    "name": "Impact",
                    "reference": "https://attack.mitre.org/tactics/TA0040/"
                },
                "technique": [
                    {
                        "id": "T1486",
                        "name": "Data Encrypted for Impact",
                        "reference": "https://attack.mitre.org/techniques/T1486/"
                    }
                ]
            }
        ],
        "tags": [
            "Druva",
            "Data Source: Druva",
            "Druva Security",
            "Druva Detection Pack 4 – Ransomware & Unusual Data Activity",
            "Druva Phase 1",
            "Druva Category: Security Monitoring"
        ],
        "version": 2,
        "type": "query",
        "language": "kuery",
        "query": "druva.uda.type:\"Encryption\"",
        "filters": [],
        "risk_score_mapping": [],
        "severity_mapping": [],
        "setup": "",
        "note": "### Investigation guide\n\nThis rule detects a Druva UDA event classified as Encryption. Such activity may indicate ransomware or another process encrypting data for impact.\n\n#### Investigation steps\n\n- Identify the affected resource, UDA details, timestamp, and available affected-file information.\n- Determine whether the activity corresponds to an approved security test or known application workload.\n- Review nearby UDA, malicious-file, quarantine, backup, and recovery events.\n- Review authentication and privileged administrative activity affecting the resource.\n- Determine the last known-good backup or curated recovery point preceding the suspicious activity.\n- Look for additional resources exhibiting similar encryption behavior.\n\n#### Response\n\n- Escalate unexplained encryption activity according to the ransomware-response process.\n- Isolate affected systems when appropriate.\n- Preserve clean recovery points and validate recoverability before restoration.",
        "max_signals": 100,
        "related_integrations": [
            {
                "package": "druva",
                "version": "^0.0.1"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "@timestamp",
                "type": "date"
            },
            {
                "ecs": false,
                "name": "druva.alert.name",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.event_type",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.feature",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "druva.resource.name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.action",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.id",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.outcome",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.severity",
                "type": "long"
            },
            {
                "ecs": true,
                "name": "message",
                "type": "match_only_text"
            },
            {
                "ecs": true,
                "name": "source.ip",
                "type": "ip"
            },
            {
                "ecs": true,
                "name": "user.email",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "user.name",
                "type": "keyword"
            }
        ],
        "investigation_fields": {
            "field_names": [
                "@timestamp",
                "event.id",
                "event.action",
                "event.outcome",
                "event.severity",
                "druva.feature",
                "druva.event_type",
                "user.name",
                "user.email",
                "source.ip",
                "druva.resource.name",
                "druva.alert.name",
                "message"
            ]
        },
        "index": [
            "logs-druva.event-*"
        ]
    },
    "id": "302df2ce-efa8-5c7c-ad5c-52ee5bd8825f_1",
    "type": "security-rule"
}
